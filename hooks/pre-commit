#!/bin/sh
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

python3 - <<'PY'
import json
from pathlib import Path
r = json.loads(Path("config/runtime.json").read_text())
assert r.get("execute") is False
assert r.get("vendor_live") is False
assert r.get("hold") is True
PY

staged=$(git diff --cached --name-only)
echo "$staged" | grep -E '(^|/)(\.env|id_rsa|credentials|secrets\.json)$' >/dev/null && exit 1

if echo "$staged" | grep -E '^(src|tests)/|runtime\.json' >/dev/null; then
  python3 -m unittest discover -s tests -q
fi
